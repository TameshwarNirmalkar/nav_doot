{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "biome check --unsafe --diagnostic-level error --max-diagnostics 100",
    "format": "biome format --write",
    "biome:fix": "biome check --files-ignore-unknown=true"
  },
  "dependencies": {
    "@ant-design/charts": "^2.6.5",
    "@ant-design/cssinjs": "^1.24.0",
    "@ant-design/nextjs-registry": "^1.1.0",
    "@types/jsonwebtoken": "^9.0.10",
    "animate.css": "^4.1.1",
    "antd": "^6.0.1",
    "antd-img-crop": "^4.25.0",
    "cookies-next": "^6.1.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jose": "^6.0.13",
    "jsonwebtoken": "^9.0.2",
    "next": "16.0.3",
    "next-auth": "^5.0.0-beta.29",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-icons": "^5.5.0",
    "react-redux": "^9.2.0",
    "redux": "^5.0.1",
    "uuid": "^13.0.0",
    "workerize-loader": "^2.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@reduxjs/toolkit": "^2.8.2",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "19.2.6",
    "@types/react-dom": "19.2.3",
    "@types/react-redux": "^7.1.34",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "baseline-browser-mapping": "^2.9.4",
    "dotenv": "^17.2.1",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.0.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "eslintConfig": {
    "parser": "@typescript-eslint/parser",
    "plugins": [
      "@typescript-eslint",
      "react-hooks"
    ],
    "extends": [
      "next/core-web-vitals",
      "eslint:recommended",
      "plugin:@typescript-eslint/recommended",
      "plugin:react-hooks/recommended"
    ],
    "rules": {
      "@typescript-eslint/no-namespace": "error",
      "semi": [
        "error",
        "always"
      ]
    }
  },
  "displayName": "Frontend",
  "resolutions": {
    "@types/react": "19.2.6",
    "@types/react-dom": "19.2.3"
  }
}
